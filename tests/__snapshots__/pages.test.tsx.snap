exports[`every page > /courses renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses</h1><div class="muted" aria-hidden="true">---------</div></header><p class="bold">Courses</p><section class="section"><h2 class="section-heading">About</h2><p>Software Engineering (Co-op) courses at the University of Ottawa. Each course lists its assignments/ and labs/.</p></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/ITI1120" data-discover="true">ITI1120/</a><span class="muted">Introduction to Computing I</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1121" data-discover="true">ITI1121/</a><span class="muted">Introduction to Computing II</span></li><li class="dir-row"><a class="dir-name" href="/courses/CSI2110" data-discover="true">CSI2110/</a><span class="muted">Data Structures and Algorithms</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2900" data-discover="true">SEG2900/</a><span class="muted">Professional Communication and Responsibility</span></li><li class="dir-row"><a class="dir-name" href="/courses/GNG2101" data-discover="true">GNG2101/</a><span class="muted">Introduction to Product Development for Engineers and Computer Scientists</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105" data-discover="true">SEG2105/</a><span class="muted">Introduction to Software Engineering</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3125" data-discover="true">SEG3125/</a><span class="muted">Analysis and Design of User Interfaces</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3101" data-discover="true">SEG3101/</a><span class="muted">Software Requirements Analysis</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102" data-discover="true">SEG3102/</a><span class="muted">Software Design and Architecture</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">CSI2110 - Data Structures and Algorithms</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>CSI2110</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Data Structures and Algorithms</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>The concept of abstract data types. Simple methods of complexity analysis. Trees. The search problem: balanced trees, binary trees, hashing. Sorting. Graphs and simple graph algorithms: traversal, minimum spanning tree. Strings and pattern matching. Prerequisites: ITI 1121, MAT 1348.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>CSI2110 syllabus, Spring/Summer 2026 (official calendar description)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Abstract data types and Big-O analysis</li><li>Linked lists, stacks, queues and deques</li><li>Priority queues and heaps</li><li>Sorting (insertion, merge, quick, heap sort)</li><li>Graphs: BFS, DFS, shortest paths</li><li>String pattern matching</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java</li><li>Coursework: 5 labs, about 1,900 lines of Java</li><li>Textbook: Goodrich, Tamassia and Goldwasser, Data Structures and Algorithms in Java</li></ul></section><section class="section"><h2 class="section-heading">Repository</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs" target="_blank" rel="noopener noreferrer">Repository</a></li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs" data-discover="true">labs/</a><span class="muted">5 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs</h1><div class="muted" aria-hidden="true">----------------------</div></header><p class="bold">CSI2110 Labs</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs/lab-1" data-discover="true">lab-1/</a><span class="muted">Lab 1: Sequence ADTs and Linked List Fundamentals</span></li><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs/lab-2" data-discover="true">lab-2/</a><span class="muted">Lab 2: Linear Data Structures and Ticket Processing</span></li><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs/lab-3" data-discover="true">lab-3/</a><span class="muted">Lab 3: Priority Queues and Heaps</span></li><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs/lab-4" data-discover="true">lab-4/</a><span class="muted">Lab 4: Sorting Algorithms and String Pattern Matching</span></li><li class="dir-row"><a class="dir-name" href="/courses/CSI2110/labs/lab-5" data-discover="true">lab-5/</a><span class="muted">Lab 5: Graphs, Traversals and Shortest Paths</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Sequence ADTs and Linked List Fundamentals</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab focuses on understanding abstract data types built around integer sequences and list structures. It introduces array-based and linked-list implementations, recursion, and core operations such as insertion, deletion, traversal, lookup, and comparison.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Array-based sequence behavior</li><li>Singly linked list operations</li><li>Circular list rotation</li><li>Doubly linked list operations</li><li>Recursive algorithms for sum, maximum, and reverse printing</li><li>Deep-copy and equivalence checks for data structures</li><li>Edge-case validation and exception handling</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>7 source files, about 454 lines</li><li>Entry point: Main.main</li><li>java.util.Arrays, java.util.Random</li></ul></section><section class="section"><h2 class="section-heading">Implementation files</h2><ul class="bullets"><li>ArrayIntegerSequence.java</li><li>LinkedIntegerSequence.java</li><li>CircularIntegerList.java</li><li>DoublyIntegerList.java</li><li>Lab1Utilities.java</li><li>Main.java</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs/tree/master/Lab/Lab1" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs/lab-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs/lab-2</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 2: Linear Data Structures and Ticket Processing</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab applies stacks, queues, deques, and list structures to a simplified ticket-processing system. The goal is to understand how ADTs behave in real-world situations and to compare array-backed and linked implementations.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Stack ADT and stack applications</li><li>Queue ADT and circular-array queue behavior</li><li>Deque operations from both ends</li><li>Dynamic-array list implementation</li><li>Positional list / iterator concepts</li><li>Ticket processing, undo actions, and queue-based service simulation</li><li>Complexity analysis and design trade-offs</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>5 source files, about 268 lines</li></ul></section><section class="section"><h2 class="section-heading">Implementation files</h2><ul class="bullets"><li>Stack.java</li><li>ArrayStack.java</li><li>Queue.java</li><li>CircularArrayQueue.java</li><li>Ticket.java</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs/tree/master/Lab/Lab2" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs/lab-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs/lab-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs/lab-3</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 3: Priority Queues and Heaps</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab introduces priority queues as an ADT and demonstrates how heaps provide efficient insert and remove-min operations. The implementation is designed around the idea that the smallest priority item is always available at the root of a min-heap.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Priority queue behavior</li><li>Heap structure and heap-order property</li><li>Insert and remove-min complexity</li><li>Min-heap representation in arrays</li><li>Task-based data objects with priorities</li><li>Efficiency comparisons against unsorted list implementations</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>6 source files, about 423 lines</li><li>Entry point: MainTester.main</li></ul></section><section class="section"><h2 class="section-heading">Implementation files</h2><ul class="bullets"><li>HeapPriorityQueue.java</li><li>ListPriorityQueue.java</li><li>PriorityQueue.java</li><li>Task.java</li><li>Entry.java</li><li>MainTester.java</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs/tree/master/Lab/lab3" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs/lab-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs/lab-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs/lab-4</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 4: Sorting Algorithms and String Pattern Matching</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab focuses on sorting strategies and the divide-and-conquer pattern. It compares simple sorting with efficient algorithms and also introduces brute-force pattern matching in text.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Insertion sort as a baseline algorithm</li><li>Merge-sort and divide-and-conquer design</li><li>Quick-sort and pivot selection</li><li>Heap-sort and heap-based sorting</li><li>Algorithm comparison across best, average, and worst cases</li><li>Stability and in-place sorting analysis</li><li>String searching and pattern occurrence counting</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>3 source files, about 128 lines</li></ul></section><section class="section"><h2 class="section-heading">Implementation files</h2><ul class="bullets"><li>SimpleSort.java</li><li>MergeSort.java</li><li>StudentRecord.java</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs/tree/master/Lab/lab4" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs/lab-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/CSI2110/labs/lab-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/CSI2110/labs/lab-5</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 5: Graphs, Traversals and Shortest Paths</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab focuses on graph theory and route-planning logic. It models locations as vertices and roads as weighted edges, then implements graph algorithms for traversal, reachability checking, and shortest path computation.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Graph ADT design</li><li>Adjacency-list graph representation</li><li>Breadth-first search (BFS)</li><li>Depth-first search (DFS)</li><li>Reachability and cycle detection</li><li>Minimum-edge path analysis</li><li>Weighted graphs and distance-aware navigation</li><li>Dijkstra's algorithm and Bellman-Ford concepts</li><li>Path reconstruction and graph validation</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>7 source files, about 665 lines</li><li>Entry point: GraphApp.main</li><li>Group lab</li></ul></section><section class="section"><h2 class="section-heading">Implementation files</h2><ul class="bullets"><li>Graph.java</li><li>AdjacencyListGraph.java</li><li>BreadthFirstSearch.java</li><li>DepthFirstSearch.java</li><li>WeightedEdge.java</li><li>Location.java</li><li>GraphApp.java</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/CSI-2110-Labs/tree/master/Lab/lab5" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/CSI2110/labs/lab-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/GNG2101 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/GNG2101</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">GNG2101 - Introduction to Product Development for Engineers and Computer Scientists</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>GNG2101</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Introduction to Product Development for Engineers and Computer Scientists</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>A hands-on, team-based introduction to product development for engineers and computer scientists. A "Design for X" approach is applied in open-ended, client-based design projects, covering economics, sustainability, business models, marketing, ethics and intellectual property. Prerequisite for software engineering: SEG 2900.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa course catalogue (summarized)</p></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/GNG2101</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">ITI1120 - Introduction to Computing I</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>ITI1120</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Introduction to Computing I</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>Introduces the logic of computing: developing algorithms that describe the solution to a problem and implementing them in a scripting language (Python). Covers computer programs, the software development process, data and variables, program logic, procedures and linear data structures.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>ITI1120 course information sheet</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Algorithm design and problem decomposition</li><li>Functions, conditionals and loops</li><li>Strings, lists and 2D lists</li><li>Dictionaries and file input</li><li>Searching, sorting and their efficiency</li><li>Exception handling</li><li>Objects and classes</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3, standard library only</li><li>Tools: IDLE, Google Colab</li><li>Coursework: 4 assignments and 9 labs, about 3,400 lines of Python</li></ul></section><section class="section"><h2 class="section-heading">Repository</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework" target="_blank" rel="noopener noreferrer">Repository</a></li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/assignments" data-discover="true">assignments/</a><span class="muted">4 assignments</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/labs" data-discover="true">labs/</a><span class="muted">9 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/assignments renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/assignments</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">ITI1120 Assignments</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/assignments/assignment-2" data-discover="true">assignment-2/</a><span class="muted">Assignment 2: Quiz Programs and Utility Functions</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/assignments/assignment-3" data-discover="true">assignment-3/</a><span class="muted">Assignment 3: Number and String Processing</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/assignments/assignment-4" data-discover="true">assignment-4/</a><span class="muted">Assignment 4: List Algorithms and a Card Game</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1120/assignments/assignment-5" data-discover="true">assignment-5/</a><span class="muted">Assignment 5: Friend Recommendations</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/assignments</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/assignments/assignment-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/assignments/assignment-2</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 2: Quiz Programs and Utility Functions</p><section class="section"><h2 class="section-heading">Overview</h2><p>Practise functions, conditionals and user interaction in Python.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>Part 1: an interactive program that welcomes a student and runs an elementary-school quiz (exponents and logarithms) or a high-school quiz (solving quadratic equations). Part 2: a set of independent functions.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Functions with parameters and return values</li><li>if / elif / else branching</li><li>User input and output formatting</li><li>Quadratic formula and logarithms with the math module</li><li>Random question generation</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>Python 3</li><li>IDLE</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>2 source files (Part 1 and Part 2), about 155 lines</li><li>Modules: random, math</li><li>Console program driven by input() prompts</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Asing/Assignment%202" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/assignments/assignment-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/assignments/assignment-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/assignments/assignment-3</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 3: Number and String Processing</p><section class="section"><h2 class="section-heading">Overview</h2><p>Practise loops and string manipulation, including solutions that avoid built-in string methods.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>Part 1: split a number string into equal pieces and test whether the pieces increase. Part 2: ten separate functions on numbers and strings.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>for and while loops</li><li>String slicing and indexing</li><li>Character-by-character processing without built-in string methods</li><li>Number sequences (Pell numbers, divisor sums)</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>Part 1 and Part 2 submitted as Python source saved as .txt files</li><li>Console program and standalone functions</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Asing/a3_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/assignments/assignment-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/assignments/assignment-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/assignments/assignment-4</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 4: List Algorithms and a Card Game</p><section class="section"><h2 class="section-heading">Overview</h2><p>Work with lists and files, and build a complete text-based game.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>Part 1: four list-processing questions. Part 2: a two-player card game against a computer dealer in which matching pairs are discarded.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>List traversal and counting</li><li>Run detection in lists</li><li>File reading and data cleaning</li><li>Game state held in lists</li><li>Input validation loops</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>5 source files (four Part 1 questions and the card game), about 214 lines</li><li>Module: random (deck shuffling)</li><li>Text-based game loop with validated console input</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Asing/Assignment%204" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/assignments/assignment-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/assignments/assignment-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/assignments/assignment-5</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 5: Friend Recommendations</p><section class="section"><h2 class="section-heading">Overview</h2><p>Model a social network from a file and compute statistics and recommendations.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>Read a network of users and friendships from a file, report statistics, and recommend a new friend for a user based on common friends.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Adjacency lists (list of lists) for a social graph</li><li>File parsing with error handling for missing files</li><li>Statistics (maximum, average)</li><li>Recommendation by counting common friends</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>1 source file, about 140 lines</li><li>Reads a network file of users and friendships</li><li>Interactive menu in main()</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Asing/Assignment%20V" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/assignments/assignment-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

