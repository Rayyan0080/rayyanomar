exports[`every page > /experience/nrc renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/experience/nrc</h1><div class="muted" aria-hidden="true">----------------</div></header><p class="bold">Materials Research Student (Co-op) - National Research Council Canada (NRC) - Aerospace Research Centre</p><section class="section"><h2 class="section-heading">Position</h2><dl class="fields"><div class="field-row"><dt class="muted">organization</dt><dd>National Research Council Canada (NRC) - Aerospace Research Centre</dd></div><div class="field-row"><dt class="muted">role</dt><dd>Materials Research Student (Co-op)</dd></div><div class="field-row"><dt class="muted">dates</dt><dd>Sep 2023 - Jun 2024</dd></div><div class="field-row"><dt class="muted">location</dt><dd>Ottawa, ON</dd></div></dl></section><section class="section"><h2 class="section-heading">Organization</h2><p>The NRC is the Government of Canada's research and technology organization. Its Aerospace Research Centre carries out research and testing for the aerospace sector.</p></section><section class="section"><h2 class="section-heading">Responsibilities</h2><ul class="bullets"><li>Validated high-temperature material resistance for over 100 aerospace samples by designing and executing testing protocols within strict safety parameters.</li><li>Plasma torch testing of material samples.</li><li>Oxyacetylene torch testing of material samples.</li><li>Microscopy and material damage analysis of tested samples.</li><li>Laser scanning of samples and 3D modelling of their surfaces.</li><li>Research and data collection for the testing programme.</li><li>Technical documentation, reports and presentations.</li></ul></section><section class="section"><h2 class="section-heading">Skills</h2><ul class="bullets"><li>High-temperature materials testing</li><li>Laboratory safety procedures</li><li>Optical microscopy and imaging workflows</li><li>Laser scanning and 3D depth mapping</li><li>Data collection and analysis</li><li>Technical writing and presenting</li></ul></section><section class="section"><h2 class="section-heading">Contributions and projects</h2><ul class="bullets"><li>Authored a 25-page technical safety manual that standardized testing operations and was adopted by all subsequent researchers in the facility.</li><li>Built high-resolution 3D depth-map and microscopic imaging workflows for degradation analysis.</li></ul></section><section class="section"><h2 class="section-heading">Achievements and outcomes</h2><ul class="bullets"><li>Improved material degradation analysis accuracy by 30% with the 3D depth-map and microscopy workflows.</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><figure class="view-only"><canvas role="img" aria-label="Research poster: Ultra-High Temperature Ceramics, Atmospheric Plasma and Oxyacetylene Torch Testing, by Rayyan Omar, Millicent Nedd, Xingbo Huang and Ali Merati, NRC"></canvas><figcaption class="muted">Research poster: Ultra-High Temperature Ceramics - Atmospheric Plasma and Oxyacetylene Torch Testing (view only)</figcaption></figure></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/experience/nrc</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

