exports[`every page > /courses/ITI1120/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Introduction to the Lab Environment</p><section class="section"><h2 class="section-heading">Overview</h2><p>Get set up in the lab environment and run first Python programs.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Writing and running a first program</li><li>Turtle graphics</li><li>Block-based programming</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li><li>IDLE</li><li>turtle module</li><li>Blockly</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>5 source files, about 144 lines</li><li>Module: turtle (graphics)</li><li>Blockly puzzle solutions included</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab1-solutions/lab1-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-2</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 2: Evaluating Expressions</p><section class="section"><h2 class="section-heading">Overview</h2><p>Predict the value of Python expressions, then check them in the interpreter and explain any differences.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Operators and precedence</li><li>Integer vs float division</li><li>The math module</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python interpreter</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Python interpreter (IDLE shell)</li><li>Solutions as two PDF task sheets</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab2-Solutions1/lab2-Solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-3</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 3: Functions and Conditionals</p><section class="section"><h2 class="section-heading">Overview</h2><p>Small Python programs built around functions and conditionals: divisibility tests, pay and letter-grade calculators, rock-paper-scissors, roots of a quadratic, and day-of-week information.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Defining functions</li><li>if / elif / else</li><li>Divisibility tests</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>7 source files, about 188 lines</li><li>Module: math</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/Lab3-solutions1/Lab3-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-5</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 5: Loops and Functions</p><section class="section"><h2 class="section-heading">Overview</h2><p>Loop practice through short functions: checking whether a list is sorted, testing perfect numbers, summing and multiplying odd numbers, and summing lists in two different ways.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>for loops</li><li>Tracing loop execution</li><li>Functions such as is_sorted and perfect-number tests</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>9 source files, about 177 lines</li><li>Module: math</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab5-solutions/lab5-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-6 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-6</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 6: while Loops and Lists</p><section class="section"><h2 class="section-heading">Overview</h2><p>while and for loops over lists: prime testing (a correct and a deliberately wrong version), first negative value, inner product, Fibonacci numbers, minimums, and building lists in various ways.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>while loops</li><li>Creating and modifying lists</li><li>Prime testing</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>13 source files, about 366 lines</li><li>Module: random</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab6-solutions/lab6-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-6</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-7 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-7</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 7</p><section class="section"><h2 class="section-heading">Overview</h2><p>List-processing functions: indexes and doubles, intersections and subsets, pairs that sum to a target, maximum-sum sublists, and counting inversions.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Lists and list methods</li><li>Functions over lists</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>1 source file, about 130 lines</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab7_solutions.py" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-7</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-8 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-8</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 8: 2D Lists, Matrices and Files</p><section class="section"><h2 class="section-heading">Overview</h2><p>2D lists as matrices (dimensions, column sums, diagonal sums, row maximums), a magic-square checker, moving zeros in place and with an extra list, and reading text files such as a periodic table and a news article.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>2D lists and matrices</li><li>Magic squares</li><li>Reading text files</li><li>In-place list algorithms</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>11 source files, about 693 lines</li><li>Reads and writes text files</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab8-solutions/lab8-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-8</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-9 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-9</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 9: Dictionaries, Searching and Sorting</p><section class="section"><h2 class="section-heading">Overview</h2><p>Dictionaries and searching: linear search in three versions, binary search, selection and insertion sort with timing, element uniqueness and majority checks, and try/except error handling.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Dictionaries</li><li>Linear and binary search</li><li>Selection sort</li><li>Algorithm efficiency</li><li>Exception handling</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>13 source files, about 683 lines</li><li>Modules: time (timing searches and sorts), random</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab9-solutions/lab9-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-9</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1120/labs/lab-10 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1120/labs/lab-10</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">Lab 10: Objects</p><section class="section"><h2 class="section-heading">Overview</h2><p>Object-oriented Python: Point, Card and Deck, BankAccount, Queue and Vector classes, plus Animal/Bird and Marsupial/Kangaroo inheritance examples.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Classes and objects</li><li>Methods and attributes</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Python 3</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python 3 (standard library only)</li><li>8 source files, about 511 lines</li><li>Modules: random, math</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/phythone-coursework/tree/main/Lab/lab10-solutions/lab10-solutions" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1120/labs/lab-10</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">ITI1121 - Introduction to Computing II</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>ITI1121</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Introduction to Computing II</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>Object-oriented programming and abstraction, including information hiding and encapsulation. Linked lists, stacks, queues and binary search trees, with iterative and recursive processing of data structures. Prerequisite: ITI 1120.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa course catalogue (summarized)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Object-oriented design: encapsulation, interfaces, inheritance, abstract classes</li><li>Generics</li><li>Stacks, queues and linked lists</li><li>Iterators and recursion</li><li>Exceptions</li><li>Comparators and sorting</li><li>Discrete-event simulation</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java, JDK standard library only</li><li>Coursework: 4 assignments and 11 labs, about 4,500 lines of Java</li><li>Programs run from the command line through main methods</li></ul></section><section class="section"><h2 class="section-heading">Repository</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121" target="_blank" rel="noopener noreferrer">Repository</a></li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/assignments" data-discover="true">assignments/</a><span class="muted">4 assignments</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/labs" data-discover="true">labs/</a><span class="muted">11 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/assignments renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/assignments</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">ITI1121 Assignments</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/assignments/assignment-1" data-discover="true">assignment-1/</a><span class="muted">Assignment 1: Parking Lot</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/assignments/assignment-2" data-discover="true">assignment-2/</a><span class="muted">Assignment 2: Parking Lot Simulator</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/assignments/assignment-3" data-discover="true">assignment-3/</a><span class="muted">Assignment 3: Capacity Optimizer</span></li><li class="dir-row"><a class="dir-name" href="/courses/ITI1121/assignments/assignment-4" data-discover="true">assignment-4/</a><span class="muted">Assignment 4: String Buffer, Iterators and Recursion</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/assignments</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/assignments/assignment-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/assignments/assignment-1</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 1: Parking Lot</p><section class="section"><h2 class="section-heading">Overview</h2><p>This assignment implements a simple parking lot system that reads a parking configuration and occupancy file, then manages vehicle parking and removal according to parking rules. It emphasizes file-based input, object modeling, and lot-management logic.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Classes and objects (Car, ParkingLot)</li><li>2D arrays for the lot layout</li><li>File parsing with java.io.File and Scanner</li><li>Enums for car types and rule checks</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>5 source files, about 323 lines</li><li>Entry point: ParkingLot.main</li><li>Input: parking lot design and occupancy file read with Scanner</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Parking status after each operation</li><li>Lot occupancy and spot availability</li><li>Whether a car can park or must leave because of rules</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Asing/a1_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/assignments/assignment-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/assignments/assignment-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/assignments/assignment-2</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 2: Parking Lot Simulator</p><section class="section"><h2 class="section-heading">Overview</h2><p>This assignment builds a simulation of a parking lot with queues, random arrivals, and probabilistic departures. It models how cars arrive over time and how they are assigned to parking spots or wait in line if the lot is full.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Discrete-event simulation</li><li>Queue ADT (linked queue)</li><li>Probability distributions</li><li>Encapsulated Spot and ParkingLot classes</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>12 source files, about 784 lines</li><li>Entry point: Simulator.main</li><li>java.util.Random for arrivals; triangular distribution for departures</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Simulation logs of car arrivals and departures</li><li>Queue length over time</li><li>Parking occupancy statistics</li><li>Simulation summary of lot usage</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Asing/a2_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/assignments/assignment-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/assignments/assignment-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/assignments/assignment-3</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 3: Capacity Optimizer</p><section class="section"><h2 class="section-heading">Overview</h2><p>This assignment goes a step further by computing the minimum number of parking spots needed to reduce excessive queue buildup. It tests a capacity model using hourly arrival patterns and departure probabilities.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Search for the minimum capacity</li><li>Averaging over repeated simulations</li><li>Exception handling and argument validation</li><li>Linked queues</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>13 source files, about 660 lines</li><li>Entry point: CapacityOptimizer.main (arrival rate as a command-line argument)</li><li>Runs 10 simulations per candidate lot size and times each run</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Recommended capacity</li><li>Queue analysis</li><li>Lot performance summary</li><li>Simulation results for different conditions</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Asing/a3_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/assignments/assignment-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/assignments/assignment-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/assignments/assignment-4</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 4: String Buffer, Iterators and Recursion</p><section class="section"><h2 class="section-heading">Overview</h2><p>This assignment focuses on custom data structures and algorithmic processing. It includes an ITIStringBuffer implementation, linked-list behavior, iteration, and recursive list processing.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Custom string buffer with a growing char array</li><li>Linked lists and iterators</li><li>Recursion over linked structures</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>15 source files across Q1, Q2 and Q3, about 731 lines</li><li>Entry points: Q1, Q2 and Q3 test classes</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Modified string content and buffer operations</li><li>List traversal and iteration results</li><li>Recursively processed list data</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Asing/a4_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/assignments/assignment-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

