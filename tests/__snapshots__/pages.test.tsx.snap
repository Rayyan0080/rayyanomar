exports[`every page > /courses/SEG3101 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3101</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">SEG3101 - Software Requirements Analysis</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>SEG3101</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Software Requirements Analysis</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>Techniques for eliciting requirements. Languages and models for representing requirements. Analysis and validation techniques, including need, goal and use case analysis. Prerequisite: SEG 2105.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa calendar (summarized)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Requirements elicitation (interviews, surveys, observation)</li><li>Writing testable functional and non-functional requirements</li><li>Stakeholder analysis</li><li>MoSCoW prioritization</li><li>Traceability</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Deliverables: written reports in LaTeX</li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3101/assignments" data-discover="true">assignments/</a><span class="muted">1 assignments</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3101/labs" data-discover="true">labs/</a><span class="muted">1 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3101</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3101/assignments renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3101/assignments</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">SEG3101 Assignments</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3101/assignments/assignment-1" data-discover="true">assignment-1/</a><span class="muted">Assignment 1: Online Grocery Store Requirements</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3101/assignments</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3101/assignments/assignment-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3101/assignments/assignment-1</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 1: Online Grocery Store Requirements</p><section class="section"><h2 class="section-heading">Overview</h2><p>Practise the requirements engineering process for a real-world scenario.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>A small independent grocery store wants an online platform (website and mobile app) where customers can browse, search, buy and pay for groceries, and choose delivery or store pickup.</p></section><section class="section"><h2 class="section-heading">Requirements</h2><ul class="bullets"><li>Problem definition</li><li>Stakeholder identification and analysis</li><li>Elicitation techniques</li><li>Functional and non-functional requirements</li><li>Prioritization</li><li>Traceability</li></ul></section><section class="section"><h2 class="section-heading">Approach and methodology</h2><p>Selected interviews, surveys and task observation as elicitation techniques. The report separates evidence from the scenario from illustrative findings and lists the evidence still to be collected, since no live elicitation took place.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Stakeholder analysis</li><li>Elicitation (interviews, surveys, observation)</li><li>MoSCoW prioritization</li><li>Traceability</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>LaTeX</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Report written in LaTeX</li><li>18 functional and 6 non-functional requirements</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>Requirements report with 18 functional requirements (FR-01 to FR-18) and 6 non-functional requirements (NFR-01 to NFR-06)</li><li>MoSCoW prioritization table with a justification of the framework</li><li>Traceability between stakeholders, elicitation findings and requirements</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3101/assignments/assignment-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3101/labs renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3101/labs</h1><div class="muted" aria-hidden="true">----------------------</div></header><p class="bold">SEG3101 Labs</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3101/labs/lab-1" data-discover="true">lab-1/</a><span class="muted">Lab 1: Evaluating Requirement Statements</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3101/labs</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3101/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3101/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Evaluating Requirement Statements</p><section class="section"><h2 class="section-heading">Overview</h2><p>Judge whether requirement statements for an electronic library system are well written, and rewrite the flawed ones.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>"shall" statements with the system as subject</li><li>One requirement per statement</li><li>Testability and ambiguity</li><li>Inclusive language</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Written lab (no code)</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>Evaluated each statement, explained its problems and proposed rewrites, such as splitting compound requirements and replacing vague timeframes with measurable ones</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3101/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">SEG3102 - Software Design and Architecture</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>SEG3102</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Software Design and Architecture</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>An advanced look at software design, extending the study of design patterns, frameworks and architectures. Survey of middleware, evaluating and evolving designs, and the basics of reengineering and reverse engineering. Prerequisite: SEG 2105.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa course catalogue (summarized)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Domain-driven design: subdomains and bounded contexts</li><li>Use case contracts and realizations</li><li>Component-based front ends</li><li>MVC and REST back ends</li><li>Dependency injection and services</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Front end: Angular 21-22 with TypeScript and RxJS</li><li>Back end: Kotlin with Spring Boot, built with Gradle</li><li>Other: Angular SSR with Express, Firebase via @angular/fire, springdoc OpenAPI</li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/assignments" data-discover="true">assignments/</a><span class="muted">1 assignments</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs" data-discover="true">labs/</a><span class="muted">6 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/assignments renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/assignments</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">SEG3102 Assignments</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/assignments/assignment-1" data-discover="true">assignment-1/</a><span class="muted">Assignment 1: DDD Contracts</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/assignments</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/assignments/assignment-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/assignments/assignment-1</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 1: DDD Contracts</p><section class="section"><h2 class="section-heading">Overview</h2><p>Apply domain-driven design to an airport employee scheduling system.</p></section><section class="section"><h2 class="section-heading">Problem statement</h2><p>An airport with hundreds of employees is replacing its employee management and scheduling system.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Domain-driven design</li><li>Core, supporting and generic subdomains</li><li>Bounded contexts</li><li>Use case contracts</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Written design document (PDF), team of two</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>Identified employee schedule management as the core domain, with payroll, employee records, access control and AI schedule generation as supporting or generic subdomains</li><li>Documented domain assumptions, such as employees belonging to exactly one department</li><li>Placed the "select work shifts" use case in the core bounded context</li></ul></section><section class="section"><h2 class="section-heading">Note</h2><p>Team of two.</p></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/assignments/assignment-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs</h1><div class="muted" aria-hidden="true">----------------------</div></header><p class="bold">SEG3102 Labs</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-1" data-discover="true">lab-1/</a><span class="muted">Lab 1: Angular Basics</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-2" data-discover="true">lab-2/</a><span class="muted">Lab 2: Spring Boot Web App</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-3" data-discover="true">lab-3/</a><span class="muted">Lab 3: Shopping List</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-4" data-discover="true">lab-4/</a><span class="muted">Lab 4: Forms and Services</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-5" data-discover="true">lab-5/</a><span class="muted">Lab 5: Address List</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG3102/labs/lab-6" data-discover="true">lab-6/</a><span class="muted">Lab 6: REST Calculator</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Angular Basics</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Angular app with two standalone components: a temperature converter and a calculator, each with its own template and route.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Components and templates</li><li>Property and event binding</li><li>Two-way binding</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Angular</li><li>TypeScript</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Framework: Angular 22 (TypeScript, standalone components)</li><li>Tooling: Angular CLI, RxJS 7.8</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>Temperature converter and calculator components</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-2</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 2: Spring Boot Web App</p><section class="section"><h2 class="section-heading">Overview</h2><p>A Kotlin Spring Boot web app. WebController serves a home page template and a /calculate endpoint that adds, subtracts, multiplies or divides two values from the form, reporting errors such as division by zero.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>MVC controllers</li><li>Request parameters</li><li>Server-side templates</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Kotlin</li><li>Spring Boot</li><li>Gradle</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Kotlin on the JVM</li><li>Framework: Spring Boot, built with Gradle (Kotlin DSL)</li><li>Controller: WebController with / and /calculate routes</li><li>Server-rendered home.html template</li><li>Test: Spring Boot context test (JUnit 5)</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>Web controller serving a server-rendered home page template</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-3</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 3: Shopping List</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Angular shopping list built from a ShoppingList parent component and ListEntry child components.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Parent and child components</li><li>@Input / @Output communication</li><li>Lists with structural directives</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Angular</li><li>TypeScript</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Framework: Angular 22 (TypeScript, standalone components)</li><li>Tooling: Angular CLI, RxJS 7.8</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>Shopping list with list-entry components</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-4</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 4: Forms and Services</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Angular app where a user form and a user details view share data through an injected UserService, configured for server-side rendering.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Reactive forms</li><li>Shared services and dependency injection</li><li>Server-side rendering</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Angular</li><li>TypeScript</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Framework: Angular 22 (TypeScript, standalone components)</li><li>Tooling: Angular CLI, RxJS 7.8</li><li>Server-side rendering: @angular/ssr with Express 5</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>User form and user details components sharing data through a service, with server-side rendering set up</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-5</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 5: Address List</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Angular address book: address list, table and detail views, a notification service, a header, and sign-in, sign-up and password-reset screens, with addresses stored in Firestore.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Services and dependency injection</li><li>Environment configuration</li><li>Routing and authentication screens</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Angular</li><li>TypeScript</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Framework: Angular 21 (TypeScript, standalone components)</li><li>Tooling: Angular CLI, RxJS 7.8</li><li>Backend: Firebase via @angular/fire</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>Address list with a notification service, header and sign-in components, and environment configuration</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3102/labs/lab-6 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3102/labs/lab-6</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 6: REST Calculator</p><section class="section"><h2 class="section-heading">Overview</h2><p>A Kotlin Spring Boot REST API. CalculatorController exposes add, subtract, multiply and divide as GET endpoints under /calculator, documented with OpenAPI.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>REST API design</li><li>Path variables</li><li>JSON responses</li></ul></section><section class="section"><h2 class="section-heading">Equipment, software and tools</h2><ul class="bullets"><li>Kotlin</li><li>Spring Boot</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Kotlin on the JVM</li><li>Framework: Spring Boot, built with Gradle (Kotlin DSL)</li><li>Spring Boot 4.1, Kotlin 2.3</li><li>REST endpoints: GET /calculator/{add|subtract|multiply|divide}/{number1}/{number2}</li><li>API docs: springdoc OpenAPI (Swagger UI)</li></ul></section><section class="section"><h2 class="section-heading">My work and contributions</h2><ul class="bullets"><li>REST calculator API (CalculatorController)</li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3102/labs/lab-6</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3125 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3125</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">SEG3125 - Analysis and Design of User Interfaces</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>SEG3125</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Analysis and Design of User Interfaces</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>Psychological principles of human-computer interaction. Evaluation of user interfaces and usability engineering. Task analysis, user-centred design and prototyping. Conceptual models, design of windows and menus, and response time and feedback. Prerequisite: SEG 2105.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa calendar (2014-15 edition, summarized)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>User-centred design and prototyping</li><li>Visual communication and hierarchy</li><li>Designing for human cognition</li><li>Usability heuristics and evaluation</li><li>Data visualization</li><li>Internationalization</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Front end: HTML/CSS, React 18-19, Bootstrap 5</li><li>Build: Vite and Create React App</li><li>Charts: Recharts</li><li>Hosting: GitHub Pages</li><li>Prototyping: Figma</li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG3125/assignments" data-discover="true">assignments/</a><span class="muted">5 assignments</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3125</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

