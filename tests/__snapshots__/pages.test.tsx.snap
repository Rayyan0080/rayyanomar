exports[`every page > /courses/ITI1121/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Java Arrays and Methods</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab covers basic Java array operations, including array insertion, average calculation, reverse sorting, and a few demonstration programs.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Arrays</li><li>Static methods</li><li>Averages, insertion and reverse sorting</li><li>Reading console input</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>6 source files, about 152 lines</li><li>Six standalone programs, each with a main method</li><li>java.util.Scanner, java.util.Arrays</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Array contents before and after processing</li><li>Average and sorted values</li><li>Reversed and inserted arrays</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab1_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-2</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 2: Combinations and a Door Lock</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab includes combinatorics and a door-lock simulation/probability exercise. It introduces logic-based problem solving and constrained decision-making.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Classes and constructors</li><li>Object equality</li><li>Encapsulated state</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>2 source files, about 70 lines</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Combinations or valid configurations</li><li>Door-lock outcomes or access states</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab2_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-3</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 3: Rational Numbers</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab introduces rational numbers and helper utilities for fraction arithmetic. It focuses on math operations with numerators and denominators.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Immutable value objects</li><li>equals and compareTo</li><li>Greatest common divisor for simplifying fractions</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>2 source files, about 189 lines</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Rational arithmetic results</li><li>Simplified fractions</li><li>Utility-generated numeric outputs</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab3_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-4</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 4: News Feed</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab models a social media/news feed application using interfaces and posts. It includes likeable posts, text posts, photo posts, and a feed manager.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Interfaces</li><li>Inheritance</li><li>Polymorphism</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>5 source files, about 139 lines</li><li>java.util.Date and Calendar for post timestamps</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>News feed entries</li><li>Post content with likes</li><li>Feed updates and ordering</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab4_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-5</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 5: Books, Libraries and Series</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab introduces books, libraries, and numeric series. It includes abstract series classes for arithmetic and geometric sequences, plus library ordering and comparison logic.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Abstract classes</li><li>Comparator</li><li>Sequences</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>7 source files, about 102 lines</li><li>java.util.Comparator, Collections.sort, ArrayList</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Book catalogs</li><li>Sorted or compared records</li><li>Series values and totals</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab5_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-6 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-6</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 6: Stacks and Dictionaries</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab focuses on stacks, dictionaries, maps, and key-value pairs. It teaches generic data structures and their applications.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Generics</li><li>Array-based stacks</li><li>Dynamic resizing</li><li>Map ADT</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>6 source files, about 223 lines</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Stack push/pop results</li><li>Dictionary lookups and mappings</li><li>Pair structure usage</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab6_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-6</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-7 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-7</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 7: Exceptions</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab builds on stack concepts and adds banking/account logic with exception handling, including insufficient funds and stack overflow cases.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Checked and unchecked exceptions</li><li>Custom exception classes</li><li>try / catch / finally</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>10 source files, about 403 lines</li><li>Entry point: Exercise1.main</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Deposit and withdrawal activity</li><li>Stack exceptions</li><li>Account state updates</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab7_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-7</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-8 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-8</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 8: Queues and Simulation</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab focuses on queues and customer service simulation. It models a cashier line and queue processing behavior.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Queue ADT</li><li>Circular array queues</li><li>Simulation</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>4 source files, about 172 lines</li><li>java.util.Random for customer arrivals</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Queue states</li><li>Customer processing order</li><li>Cashier service summary</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab8_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-8</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-9 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-9</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 9: Playlists and Sorting</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab works with sorting, playlists, and secret message handling. It covers custom comparators and collection ordering.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Dynamic arrays</li><li>Comparators</li><li>File input</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>6 source files, about 257 lines</li><li>Entry point: SecretMessage.main</li><li>Reads songs from a file with StringTokenizer</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Playlist sorted by title/artist/album</li><li>Decoded or transformed secret message</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab9_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-9</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-10 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-10</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">Lab 10: Ordered Lists</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab covers ordered structures and ordered lists, introducing sorted container behavior and ordered data management.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Linked lists</li><li>Ordered insertion</li><li>Merging</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>2 source files, about 135 lines</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Inserted values in sorted order</li><li>Ordered list operations</li><li>Structure traversal results</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab10_300434818%20(2)/lab10_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-10</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/ITI1121/labs/lab-11 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/ITI1121/labs/lab-11</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">Lab 11: Iterators and Bit Lists</p><section class="section"><h2 class="section-heading">Overview</h2><p>This lab introduces bit lists and iterative processes, with iterator support and bit-level operations.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Iterators</li><li>Inner classes</li><li>Bitwise operations</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java (JDK standard library)</li><li>3 source files, about 193 lines</li></ul></section><section class="section"><h2 class="section-heading">Typical output</h2><ul class="bullets"><li>Bit values and set/clear operations</li><li>Iterator traversal through data</li><li>Iterative algorithm results</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/ITI1121/tree/main/Lab/lab11_300434818" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/ITI1121/labs/lab-11</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105</h1><div class="muted" aria-hidden="true">-----------------</div></header><p class="bold">SEG2105 - Introduction to Software Engineering</p><section class="section"><h2 class="section-heading">Course</h2><dl class="fields"><div class="field-row"><dt class="muted">code</dt><dd>SEG2105</dd></div><div class="field-row"><dt class="muted">name</dt><dd>Introduction to Software Engineering</dd></div></dl></section><section class="section"><h2 class="section-heading">Description</h2><p>Principles of software engineering: requirements, design and testing. Review of object orientation, object-oriented analysis with UML, frameworks and APIs, client-server architecture, and an introduction to user interface technology. Prerequisite: ITI 1121.</p></section><section class="section"><h2 class="section-heading">Source</h2><p>uOttawa calendar (earlier edition, summarized)</p></section><section class="section"><h2 class="section-heading">Techniques used</h2><ul class="bullets"><li>Object-oriented design and UML</li><li>Team development with Git and GitHub</li><li>Android app development (activities, intents, layouts)</li><li>Client-server architecture with frameworks</li><li>Cloud databases (Firebase)</li><li>UI testing with Espresso</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Languages: Java (desktop and Android)</li><li>Android: Gradle (Kotlin DSL), minSdk 24, targetSdk 34-36</li><li>Backends: Firebase Realtime Database, Firebase Authentication and Cloud Firestore</li><li>Frameworks: OCSF client-server framework</li></ul></section><section class="section"><h2 class="section-heading">Repository</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework" target="_blank" rel="noopener noreferrer">Repository</a></li></ul></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/assignments" data-discover="true">assignments/</a><span class="muted">2 assignments</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs" data-discover="true">labs/</a><span class="muted">6 labs</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/assignments renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/assignments</h1><div class="muted" aria-hidden="true">-----------------------------</div></header><p class="bold">SEG2105 Assignments</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/assignments/simplechat" data-discover="true">simplechat/</a><span class="muted">simpleChat: Client-Server Chat</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/assignments/otams" data-discover="true">otams/</a><span class="muted">Course Project: OTAMS Tutoring App (Group 7)</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/assignments</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/assignments/otams renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/assignments/otams</h1><div class="muted" aria-hidden="true">-----------------------------------</div></header><p class="bold">Course Project: OTAMS Tutoring App (Group 7)</p><section class="section"><h2 class="section-heading">Overview</h2><p>Team Android app for booking tutoring sessions. See the project page for details.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Role-based access control</li><li>Approval workflows</li><li>Team development with Git</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Platform: Android (Java), Gradle</li><li>Backend: Firebase Authentication and Cloud Firestore</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="/projects/university-projects/otams" data-discover="true">Project page</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/assignments/otams</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/assignments/simplechat renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/assignments/simplechat</h1><div class="muted" aria-hidden="true">----------------------------------------</div></header><p class="bold">simpleChat: Client-Server Chat</p><section class="section"><h2 class="section-heading">Overview</h2><p>A console chat application built on the course's Object Client-Server Framework (OCSF), extending the provided base code.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Client-server architecture</li><li>Framework hook methods (AbstractClient / AbstractServer)</li><li>Sockets and threads</li><li>Command parsing in a console UI</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>Java</li><li>Sockets (OCSF)</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java</li><li>6 source files, about 601 lines, plus the OCSF framework</li><li>Entry points: ClientConsole (client) and ServerConsole (server)</li><li>Default port: 5555 over TCP sockets</li><li>Test harness: SemiAutoChatRunner</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>ChatClient / ClientConsole: a client that needs a login ID and reports when it cannot connect</li><li>EchoServer / ServerConsole: a server that listens on port 5555 by default and accepts console commands</li><li>SemiAutoChatRunner runs the course's semi-automatic test cases; a recorded run is included</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/assignments/simpleChat" target="_blank" rel="noopener noreferrer">Source code</a></li><li><a href="https://github.com/Rayyan0080/simpleChat" target="_blank" rel="noopener noreferrer">Original fork with history</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/assignments/simplechat</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs</h1><div class="muted" aria-hidden="true">----------------------</div></header><p class="bold">SEG2105 Labs</p><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/lab-1" data-discover="true">lab-1/</a><span class="muted">Lab 1: Team Git Workflow</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/lab-2" data-discover="true">lab-2/</a><span class="muted">Lab 2: PointCP Design</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/lab-3" data-discover="true">lab-3/</a><span class="muted">Lab 3: Calculator App</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/lab-4" data-discover="true">lab-4/</a><span class="muted">Lab 4: Team Logo App</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/lab-5" data-discover="true">lab-5/</a><span class="muted">Lab 5: Espresso UI Tests</span></li><li class="dir-row"><a class="dir-name" href="/courses/SEG2105/labs/firebase-lab" data-discover="true">firebase-lab/</a><span class="muted">Firebase Lab: Product Catalog</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/firebase-lab renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/firebase-lab</h1><div class="muted" aria-hidden="true">-----------------------------------</div></header><p class="bold">Firebase Lab: Product Catalog</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Android product catalog backed by Firebase Realtime Database. Products are added from a form, listed live, and updated or deleted from a dialog opened by a long press.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Firebase Realtime Database</li><li>Create, read, update and delete</li><li>Real-time listeners</li><li>Custom list adapters</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Platform: Android, written in Java</li><li>Build: Gradle (Kotlin DSL), minSdk 24, targetSdk 36, Java 11</li><li>5 source files, about 238 lines</li><li>Library: Firebase Realtime Database</li><li>Data: a "products" node of {id, name, price} records</li><li>Requires your own google-services.json</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-firebase-product-catalog" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/firebase-lab</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/lab-1 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/lab-1</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 1: Team Git Workflow</p><section class="section"><h2 class="section-heading">Overview</h2><p>The team set up a shared GitHub repository and practised cloning, committing, pushing and resolving merge conflicts. Each member added their own file and their name to team.txt.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Git clone/commit/push/pull</li><li>Merge conflicts</li><li>Team collaboration on GitHub</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Git and GitHub</li><li>Plain text files, one per team member</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-1-git-workflow" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/lab-1</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/lab-2 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/lab-2</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 2: PointCP Design</p><section class="section"><h2 class="section-heading">Overview</h2><p>PointCP stores a point in either polar or cartesian form and converts between them. PointCPTest reads a coordinate type and two values and prints the point in both forms, as a basis for discussing design trade-offs between internal representations.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Class design</li><li>Encapsulation</li><li>Alternative internal representations</li><li>Design trade-offs</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Java</li><li>2 source files, about 291 lines</li><li>Entry point: PointCPTest.main (command-line or prompted input)</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-2-pointcp" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/lab-2</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/lab-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/lab-3</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 3: Calculator App</p><section class="section"><h2 class="section-heading">Overview</h2><p>An Android calculator. Digit buttons build the current number, and operator buttons are handled with an Operator enum that tracks the pending operation.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Android Studio project setup</li><li>XML layouts</li><li>Button click handlers</li><li>UI state in an Activity</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Platform: Android, written in Java</li><li>Build: Gradle (Kotlin DSL), minSdk 24, targetSdk 36, Java 11</li><li>3 source files, about 154 lines</li><li>Libraries: AndroidX AppCompat, Material, ConstraintLayout</li><li>Default JUnit and Espresso test stubs</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-3-calculator" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/lab-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/lab-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/lab-4</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 4: Team Logo App</p><section class="section"><h2 class="section-heading">Overview</h2><p>A multi-screen Android app: enter a team name and postal code, pick a logo on a second screen, open the postal code in Google Maps with an implicit intent, and see a confirmation screen.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Explicit and implicit intents</li><li>startActivityForResult / onActivityResult</li><li>Passing Serializable objects between activities</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Platform: Android, written in Java</li><li>Build: Gradle (Kotlin DSL), minSdk 24, targetSdk 34, Java 8</li><li>6 source files, about 174 lines</li><li>Activities: MainActivity, LogoSelectorActivity, ConfirmationActivity</li><li>Libraries: AndroidX AppCompat, Material, ConstraintLayout</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-4-team-logo" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/lab-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG2105/labs/lab-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG2105/labs/lab-5</h1><div class="muted" aria-hidden="true">----------------------------</div></header><p class="bold">Lab 5: Espresso UI Tests</p><section class="section"><h2 class="section-heading">Overview</h2><p>Instrumented Espresso tests for a student registration screen that type into the form, press register, and check the validation errors shown.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Android instrumented testing</li><li>ActivityScenarioRule</li><li>Espresso onView / perform / check</li><li>Input validation</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Platform: Android instrumented tests (Java)</li><li>2 test classes, about 59 lines</li><li>Libraries: Espresso, AndroidX Test (ActivityScenarioRule), JUnit 4</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="https://github.com/Rayyan0080/SEG2105-Coursework/tree/main/labs/lab-5-espresso-tests" target="_blank" rel="noopener noreferrer">Source code</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG2105/labs/lab-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

