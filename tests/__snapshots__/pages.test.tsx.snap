exports[`every page > /projects/personal-projects/mcu-watchpath renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/personal-projects/mcu-watchpath</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Marvel Connected Universe Graph (MCU Watchpath)</p><section class="section"><h2 class="section-heading">Overview</h2><p>An interactive knowledge graph of Marvel movies and TV shows, their relationships, and the minimum viewing path needed to understand any entry.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p>Working out which earlier Marvel titles you need to watch before a given one.</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Interactive node graph of 109 entries (78 movies, 31 series) across 8 Marvel universes</li><li>Recursive watch paths that trace required prerequisites back to root entries</li><li>Typed relationships such as Required, Sequel, Crossover and Multiverse</li><li>Timeline view, full-text search, filters and spoiler-free descriptions</li><li>Data validation for unique IDs, broken references and circular prerequisites</li><li>Static deployment with a scheduled data-update workflow</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>React 19</li><li>TypeScript</li><li>Vite</li><li>React Flow</li><li>Zustand</li><li>Fuse.js</li><li>Vitest</li><li>CSS</li><li>JavaScript</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><ul class="bullets"><li>Typed data modules for movies, series, relationships, characters and universes</li><li>Graph utilities for root detection, dependency trees and topological sorting</li><li>GitHub Actions for deployment and weekly data updates</li></ul></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Sole contributor to the repository.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 19, TypeScript 6, Vite 8</li><li>Libraries: React Router 7, React Flow 11, Zustand 5, Fuse.js 7, Framer Motion, Lucide icons</li><li>Tests: Vitest 4 with Testing Library and jsdom</li><li>Linting: oxlint</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https://github.com/Rayyan0080/MCU.watchpath" target="_blank" rel="noopener noreferrer">https://github.com/Rayyan0080/MCU.watchpath</a></dd></div><div class="field-row"><dt class="muted">live demo</dt><dd><a href="https://rayyan0080.github.io/MCU.watchpath/" target="_blank" rel="noopener noreferrer">https://rayyan0080.github.io/MCU.watchpath/</a></dd></div><div class="field-row"><dt class="muted">created</dt><dd>2026-08-14</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2026-08-17</dd></div><div class="field-row"><dt class="muted">languages</dt><dd>TypeScript, CSS, JavaScript, HTML</dd></div></dl></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/personal-projects/mcu-watchpath</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/personal-projects/portfolio renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/personal-projects/portfolio</h1><div class="muted" aria-hidden="true">--------------------------------------</div></header><p class="bold">rayyanomar.com</p><section class="section"><h2 class="section-heading">Overview</h2><p>This website: a keyboard-driven portfolio that works like a Linux terminal, where every section is a directory you can cd into.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p class="todo">[to be added: The problem this project addresses]</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Virtual directory tree with cd, ls, pwd, back, history and tab completion</li><li>Content kept in typed data files, separate from the navigation logic</li><li>GitHub metadata synced at build time rather than requested per visit</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>React</li><li>TypeScript</li><li>Vite</li><li>React Router</li><li>GitHub Actions</li><li>GitHub Pages</li><li>CSS</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><p class="todo">[to be added: How the project is structured]</p></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Sole developer.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 19, TypeScript 5.8, Vite 6</li><li>Styling: Tailwind CSS 4</li><li>Routing: React Router 7</li><li>Content built at compile time from typed data files; GitHub metadata synced with the gh CLI</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https://github.com/Rayyan0080/rayyanomar" target="_blank" rel="noopener noreferrer">https://github.com/Rayyan0080/rayyanomar</a></dd></div><div class="field-row"><dt class="muted">live demo</dt><dd><a href="https://rayyanomar.com/" target="_blank" rel="noopener noreferrer">https://rayyanomar.com/</a></dd></div><div class="field-row"><dt class="muted">created</dt><dd>2026-11-02</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2026-11-04</dd></div><div class="field-row"><dt class="muted">languages</dt><dd>TypeScript, CSS, HTML</dd></div></dl></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/personal-projects/portfolio</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

