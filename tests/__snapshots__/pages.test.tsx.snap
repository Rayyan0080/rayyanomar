exports[`every page > /experience/hack-the-hill renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/experience/hack-the-hill</h1><div class="muted" aria-hidden="true">--------------------------</div></header><p class="bold">Co-VP of Logistics - Hack the Hill</p><section class="section"><h2 class="section-heading">Position</h2><dl class="fields"><div class="field-row"><dt class="muted">organization</dt><dd>Hack the Hill</dd></div><div class="field-row"><dt class="muted">role</dt><dd>Co-VP of Logistics</dd></div><div class="field-row"><dt class="muted">dates</dt><dd>2026</dd></div><div class="field-row"><dt class="muted">location</dt><dd>Ottawa, ON</dd></div></dl></section><section class="section"><h2 class="section-heading">Organization</h2><p>A 36-hour student hackathon held in Ottawa.</p></section><section class="section"><h2 class="section-heading">Responsibilities</h2><ul class="bullets"><li>Directed end-to-end event operations for 900+ participants: check-ins, ticketing pipelines and real-time problem solving.</li><li>Organized and managed Full-Stack Development and AI/ML workshop panels for an audience of 500+ attendees.</li><li>Negotiated and managed catering for 900+ attendees across the 36-hour event.</li><li>Secured centralized overnight accommodation for the organizing team.</li></ul></section><section class="section"><h2 class="section-heading">Skills</h2><ul class="bullets"><li>Event operations</li><li>Logistics planning</li><li>Vendor negotiation</li><li>Team coordination</li><li>Problem solving under time pressure</li></ul></section><section class="section"><h2 class="section-heading">Contributions and projects</h2><p class="todo">[to be added: Specific contributions or projects]</p></section><section class="section"><h2 class="section-heading">Achievements and outcomes</h2><ul class="bullets"><li>Reduced entry queue times through the check-in and ticketing process.</li></ul></section><sect