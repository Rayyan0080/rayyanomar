uted">created</dt><dd>2025-01-10</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2025-01-10</dd></div></dl></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/personal-projects/tic-tac-toe</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

