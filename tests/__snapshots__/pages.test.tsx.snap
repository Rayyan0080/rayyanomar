exports[`every page > /courses/SEG3125/assignments/assignment-3 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3125/assignments/assignment-3</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 3: Memory Game</p><section class="section"><h2 class="section-heading">Overview</h2><p>Design a memory game around human cognition.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Designing for attention and short-term memory</li><li>Difficulty levels</li><li>Game state in React hooks</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>React</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 18 with Vite</li><li>React Router 6</li><li>Deployed with gh-pages</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>Sequence-memory game with three difficulty levels and a results page</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="/projects/university-projects/memory-game" data-discover="true">Project page</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3125/assignments/assignment-3</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3125/assignments/assignment-4 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3125/assignments/assignment-4</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 4: E-commerce</p><section class="section"><h2 class="section-heading">Overview</h2><p>Design an e-commerce site with faceted search, evaluated against usability heuristics.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Faceted search and filtering</li><li>Multi-step checkout with a progress indicator</li><li>Usability heuristic evaluation</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>React</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 18 with Vite</li><li>React Router 6</li><li>Deployed with gh-pages</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>TechNova electronics store: filters, cart, multi-step checkout and feedback survey</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="/projects/university-projects/technova" data-discover="true">Project page</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3125/assignments/assignment-4</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /courses/SEG3125/assignments/assignment-5 renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/courses/SEG3125/assignments/assignment-5</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Assignment 5: Dashboard</p><section class="section"><h2 class="section-heading">Overview</h2><p>Design a data visualization dashboard with internationalization.</p></section><section class="section"><h2 class="section-heading">Techniques and concepts</h2><ul class="bullets"><li>Data visualization</li><li>Internationalization (English and French)</li><li>Filter-driven views</li></ul></section><section class="section"><h2 class="section-heading">Technologies and tools</h2><ul class="bullets"><li>React</li><li>Recharts</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 18 with Vite</li><li>Recharts for charts, React Router 7</li><li>Deployed with gh-pages</li></ul></section><section class="section"><h2 class="section-heading">My implementation and contributions</h2><ul class="bullets"><li>Formula 1 dashboard with filters, charts and English/French language switching</li></ul></section><section class="section"><h2 class="section-heading">Source code</h2><ul class="bullets"><li><a href="/projects/university-projects/f1-dashboard" data-discover="true">Project page</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/courses/SEG3125/assignments/assignment-5</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

