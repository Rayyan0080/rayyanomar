exports[`every page > /projects/university-projects renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/university-projects</h1><div class="muted" aria-hidden="true">------------------------------</div></header><section class="section"><h2 class="section-heading">About</h2><p>Course work with a public repository and, where available, a live demo. Course context is under /courses.</p></section><section class="listing" aria-label="Directory contents"><h2 class="accent bold">Contents</h2><ul class="dir-list"><li class="dir-row"><a class="dir-name" href="/projects/university-projects/seg3125-portfolio" data-discover="true">seg3125-portfolio/</a><span class="muted">SEG3125 Assignment 1 - terminal-themed portfolio</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/precision-auto-repair" data-discover="true">precision-auto-repair/</a><span class="muted">SEG3125 Assignment 2 - service business website</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/memory-game" data-discover="true">memory-game/</a><span class="muted">SEG3125 Assignment 3 - sequence memory game</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/technova" data-discover="true">technova/</a><span class="muted">SEG3125 Assignment 4 - electronics e-commerce site</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/f1-dashboard" data-discover="true">f1-dashboard/</a><span class="muted">SEG3125 Assignment 5 - bilingual data dashboard</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/otams" data-discover="true">otams/</a><span class="muted">SEG2105 team Android app for booking tutoring sessions</span></li><li class="dir-row"><a class="dir-name" href="/projects/university-projects/simplechat" data-discover="true">simplechat/</a><span class="muted">SEG2105 client-server chat assignment</span></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/university-projects</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/university-projects/f1-dashboard renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/university-projects/f1-dashboard</h1><div class="muted" aria-hidden="true">-------------------------------------------</div></header><p class="bold">F1 Dashboard</p><section class="section"><h2 class="section-heading">Overview</h2><p>A Formula 1 statistics dashboard designed for SEG3125, showing driver and constructor points, wins and podiums by season.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p class="todo">[to be added: The problem this project addresses]</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Bar and line charts with Recharts</li><li>Filters and statistics cards</li><li>English and French interface with a language selector</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>React</li><li>Vite</li><li>Recharts</li><li>JavaScript</li><li>CSS</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><p class="todo">[to be added: How the project is structured]</p></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Sole contributor to the repository.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><ul class="bullets"><li>The dataset is a synthetic sample built for visualization, not live race data.</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 18 with Vite</li><li>Charts: Recharts 2.12</li><li>Routing: React Router 7</li><li>Deployed to GitHub Pages with gh-pages</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https://github.com/Rayyan0080/f1-Dashboard" target="_blank" rel="noopener noreferrer">https://github.com/Rayyan0080/f1-Dashboard</a></dd></div><div class="field-row"><dt class="muted">live demo</dt><dd><a href="https://rayyan0080.github.io/f1-Dashboard/" target="_blank" rel="noopener noreferrer">https://rayyan0080.github.io/f1-Dashboard/</a></dd></div><div class="field-row"><dt class="muted">created</dt><dd>2026-07-11</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2026-11-04</dd></div><div class="field-row"><dt class="muted">languages</dt><dd>JavaScript, CSS, HTML</dd></div></dl></section><section class="section"><h2 class="section-heading">Related</h2><ul class="bullets"><li><a href="/courses/SEG3125/assignments/assignment-5" data-discover="true">Course assignment</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/university-projects/f1-dashboard</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/university-projects/memory-game renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/university-projects/memory-game</h1><div class="muted" aria-hidden="true">------------------------------------------</div></header><p class="bold">Memory Game</p><section class="section"><h2 class="section-heading">Overview</h2><p>A sequence-memory game with a mechanic's-tools theme, designed for SEG3125 around how human memory works.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p class="todo">[to be added: The problem this project addresses]</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Difficulty levels: Beginner (3 steps), Intermediate (5) and Expert (8)</li><li>Settings panel, game board and a "Diagnostic Report" results page</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>React</li><li>Vite</li><li>JavaScript</li><li>CSS</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><p class="todo">[to be added: How the project is structured]</p></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Sole contributor to the repository.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>React 18 with Vite</li><li>React Router 6</li><li>Deployed to GitHub Pages with gh-pages</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https: