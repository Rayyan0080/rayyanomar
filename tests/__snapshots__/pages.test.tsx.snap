exports[`every page > /projects/software-development/aeroguard renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/software-development/aeroguard</h1><div class="muted" aria-hidden="true">-----------------------------------------</div></header><p class="bold">AeroGuard (A.E.G.I.S. Garden)</p><section class="section"><h2 class="section-heading">Overview</h2><p>An AI-powered security operations centre (SOC) platform built at HackConcordia. It won First Place for Best Use of Snowflake.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p>Alert fatigue: security analysts lose time triaging large volumes of low-context alerts.</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Explainable, prompt-based alert generation with the Google Gemini API</li><li>Incident triage decisions in under 60 seconds</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>FastAPI</li><li>Snowflake</li><li>MongoDB</li><li>Google Gemini</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><ul class="bullets"><li>Parallel data-ingestion flows</li><li>MongoDB for application state</li><li>Snowflake for telemetry analytics</li></ul></section><section class="section"><h2 class="section-heading">My contributions</h2><p class="todo">[to be added: My role and contributions]</p></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Achievements</h2><ul class="bullets"><li>First Place, Best Use of Snowflake, HackConcordia</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd>Not public</dd></div><div class="field-row"><dt class="muted">live demo</dt><dd>None</dd></div></dl></section><section class="section"><h2 class="section-heading">Related</h2><ul class="bullets"><li><a href="/experience/hackathons/hackconcordia" data-discover="true">Hackathon entry</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/software-development/aeroguard</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/software-development/brainrot-short-generator renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/software-development/brainrot-short-generator</h1><div class="muted" aria-hidden="true">--------------------------------------------------------</div></header><p class="bold">Brainrot Short Generator</p><section class="section"><h2 class="section-heading">Overview</h2><p>Generates 9:16 vertical videos that explain a historical figure or event in Gen-Z slang, pairing an AI-written script and text-to-speech narration with gameplay footage.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p class="todo">[to be added: The problem this project addresses]</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Three-tier script generation: Gemini API, then a local Ollama LLM, then built-in demo scripts, so it always works</li><li>Text-to-speech narration sped up 1.2x</li><li>Generated gradient title images (Pillow, no ImageMagick)</li><li>Split-screen 1080x1920 output: image on top, looped gameplay below</li><li>Flask web interface and a command-line interface</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>Python</li><li>Flask</li><li>MoviePy</li><li>gTTS</li><li>Pillow</li><li>Google Gemini</li><li>Ollama</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><ul class="bullets"><li>Topic input, script generation, TTS audio, image generation, then MoviePy compositing into an MP4</li></ul></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Sole contributor to the repository.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Language: Python</li><li>Web app: Flask 3.0 serving an HTML template</li><li>Video and audio: MoviePy 1.0.3, gTTS 2.5.3, Pillow 10.4</li><li>AI: google-generativeai 0.8.3, with a local Ollama client as an alternative</li><li>Config: python-dotenv (.env template)</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https://github.com/Rayyan0080/convibecooding" target="_blank" rel="noopener noreferrer">https://github.com/Rayyan0080/convibecooding</a></dd></div><div class="field-row"><dt class="muted">live demo</dt><dd>None</dd></div><div class="field-row"><dt class="muted">created</dt><dd>2026-01-24</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2026-01-24</dd></div><div class="field-row"><dt class="muted">languages</dt><dd>Python, HTML</dd></div></dl></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/software-development/brainrot-short-generator</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/software-development/chronos-cloud renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/software-development/chronos-cloud</h1><div class="muted" aria-hidden="true">---------------------------------------------</div></header><p class="bold">Chronos Cloud: AI Smart City Command Center</p><section class="section"><h2 class="section-heading">Overview</h2><p>Project Chronos is a software-only digital twin for crisis management. It simulates, detects and responds to crisis scenarios in real time across power, airspace, transit and traffic, using an event-driven architecture and autonomous agents.</p><p>Year: 2026</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p>Traditional crisis-response systems are rigid, tightly coupled to hardware and slow to adapt, with little real-time data integration.</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>Multi-domain monitoring: power grid, airspace, OC Transpo transit and Ottawa/Ontario 511 traffic</li><li>Three decision frameworks compared side by side: rules engine, single LLM and multi-agent mesh</li><li>Live dashboard with an event feed and a MapLibre map of incidents and risk areas</li><li>Voice announcements with ElevenLabs, falling back to the browser</li><li>Human-in-the-loop verification UI that logs every AI assumption and outcome</li><li>Graceful fallbacks to mock data and rules when external services are unavailable</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>Python</li><li>FastAPI</li><li>Next.js</li><li>TypeScript</li><li>MongoDB</li><li>NATS / Solace PubSub+</li><li>Gemini</li><li>Cerebras</li><li>MapLibre GL</li><li>Docker</li><li>JavaScript</li><li>CSS</li><li>C++</li><li>PowerShell</li><li>HTML</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><ul class="bullets"><li>Event sources (crisis generator, live data adapters, flight plans) publish to a message broker (NATS locally, Solace PubSub+ in production)</li><li>Python agent services (coordinator, autonomy router, risk agents) consume events</li><li>AI services (Gemini, Cerebras) with a rules-engine fallback produce recovery plans</li><li>MongoDB stores events; a Next.js dashboard streams updates over server-sent events</li></ul></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Team project; the repository is hosted on my account.</li><li>Orchestrated an event-driven architecture of 14 APIs and 7 specialized AI agents (résumé).</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Achievements</h2><ul class="bullets"><li>Reduced decision-making latency for city operators by over 80%, from hours to minutes, by correlating cascading risks across transit and traffic (résumé).</li></ul></section><section class="section"><h2 class="section-heading">Technical specifications</h2><ul class="bullets"><li>Backend agents: Python with pydantic, nats-py, pymongo, Solace PubSub+ client and Sentry SDK</li><li>Dashboard: Next.js 14, React 18, TypeScript 5, MapLibre GL 4</li><li>Infrastructure: Docker Compose with NATS 2.10, MongoDB 7.0 and mongo-express</li><li>Simulation source in C++ (QNX grid simulator)</li></ul></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd><a href="https://github.com/Rayyan0080/chronosccloud.tech" target="_blank" rel="noopener noreferrer">https://github.com/Rayyan0080/chronosccloud.tech</a></dd></div><div class="field-row"><dt class="muted">live demo</dt><dd>None</dd></div><div class="field-row"><dt class="muted">created</dt><dd>2026-01-17</dd></div><div class="field-row"><dt class="muted">updated</dt><dd>2026-11-04</dd></div><div class="field-row"><dt class="muted">languages</dt><dd>Python, TypeScript, JavaScript, CSS, C++, PowerShell, Shell, HTML</dd></div></dl></section><section class="section"><h2 class="section-heading">Related</h2><ul class="bullets"><li><a href="/experience/hackathons/chronos-cloud" data-discover="true">Hackathon entry</a></li></ul></section></article><div class="line input-line"><span class="prompt"><span class="prompt-user">rayyan@portfolio</span>:<span class="prompt-path">~/projects/software-development/chronos-cloud</span>$ </span><span class="input-mirror" aria-hidden="true"><span class="cursor"> </span></span><input class="input-native" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" enterkeyhint="go" aria-label="Terminal command input" type="text" value=""></div></main>"`;

exports[`every page > /projects/software-development/parkingsporter renders 1`] = `"<main class="terminal"><article class="page"><header class="page-header"><h1 class="accent bold">~/projects/software-development/parkingsporter</h1><div class="muted" aria-hidden="true">----------------------------------------------</div></header><p class="bold">ParkingSporter</p><section class="section"><h2 class="section-heading">Overview</h2><p>A full-stack mobile application with a Java/Spring Boot backend and a React frontend, built in 36 hours.</p><p>Year: 2025</p></section><section class="section"><h2 class="section-heading">Problem being solved</h2><p class="todo">[to be added: The problem this project addresses]</p></section><section class="section"><h2 class="section-heading">Main features</h2><ul class="bullets"><li>REST API integrating external APIs for incident detection, with response latency under 500 ms</li></ul></section><section class="section"><h2 class="section-heading">Technologies used</h2><ul class="bullets"><li>Java</li><li>Spring Boot</li><li>React</li><li>Android Studio</li></ul></section><section class="section"><h2 class="section-heading">Architecture and implementation</h2><p class="todo">[to be added: How the project is structured]</p></section><section class="section"><h2 class="section-heading">My contributions</h2><ul class="bullets"><li>Architected the backend, integrating Spring Boot with the React frontend.</li></ul></section><section class="section"><h2 class="section-heading">Challenges</h2><p class="todo">[to be added: Challenges encountered and how they were handled]</p></section><section class="section"><h2 class="section-heading">Links</h2><dl class="fields"><div class="field-row"><dt class="muted">repository</dt><dd>Not public</dd></div><div class="field-row"><dt class="muted">live demo</dt><dd>None</dd></div></dl></section><section class="section"><h2 class="section-heading">Related</h2><ul class="bullets"><li><a href="/experience/hackathon